{
  "name": "ministrycommons-org",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy-prod": "npm run build",
    "exec-deploy-prod": "aws s3 sync dist/ s3://ministrycommons-web --delete",
    "invalidate-prod": "aws cloudfront create-invalidation --distribution-id E26HUBKU5QIXG5 --paths \"/*\"",
    "deploy-prod": "npm run predeploy-prod && npm run exec-deploy-prod && npm run invalidate-prod"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  }
}
